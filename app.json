{
  "expo": {
    "name": "Ping",
    "slug": "ping-couple-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ping",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.applaunch.ping"
    },
    "android": {
      "package": "io.applaunch.ping",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        { "photosPermission": "Allow Ping to access your photos to share memories." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
